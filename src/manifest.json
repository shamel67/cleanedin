{
  "manifest_version": 3,
  "name": "FeedSift - Find the signal. Skip the noise.",
  "author": "Immeria Inc. (Stéphane Hamel)",
  "version": "1.4.0",
  "description": "Find the signal. Skip the noise. FeedSift helps you hide distractions and focus your feed.",
  "homepage_url": "https://github.com/shamel67/feedsift",
  "minimum_chrome_version": "149",
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_icon": "assets/img/feedsift.png"
  },
  "icons": {
    "16": "assets/img/feedsift.png",
    "48": "assets/img/feedsift.png",
    "128": "assets/img/feedsift.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/privacy.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/cssContains.js",
        "content/ai.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/probe.js",
        "content/content.css",
        "assets/settings/*.json"
      ],
      "matches": [
        "*://*.linkedin.com/*"
      ]
    }
  ]
}